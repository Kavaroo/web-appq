{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-appq",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "cac00d45-9567-4bfa-a7af-04c171f2134f","database_name": "web-appq" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "aa669216deee4699b2de579e231ad079" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
